# Created by Vercel CLI — Vercel build-time vars only.
# DO NOT add API keys or secrets here; they must be set in the Vercel dashboard.
# This file intentionally omits env vars that have values in .env so that
# .env acts as the fallback (Next.js loads .env.production before .env, so any
# key listed here — even as an empty string — shadows the .env value).
NX_DAEMON="false"
TURBO_CACHE="remote:rw"
TURBO_DOWNLOAD_LOCAL_ENABLED="true"
TURBO_REMOTE_ONLY="true"
TURBO_RUN_SUMMARY="true"
